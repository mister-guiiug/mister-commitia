{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mister-commitia",
  "version": "0.1.0",
  "identifier": "com.guiiug.mistercommitia",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mister-commitia — assainissement gouverné d'historiques Git & CI/CD",
        "width": 1360,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "resources": {
      "../../../skills/": "skills/"
    }
  }
}
